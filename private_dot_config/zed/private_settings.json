 {
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "edit_predictions": {
    "provider": "open_ai_compatible_api",
    "open_ai_compatible_api": {
      "prompt_format": "deepseek_coder",
      "model": "deepseek-chat",
      "api_url": "https://api.deepseek.com/beta/completions"
    },
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    }
  },
  "show_edit_predictions": true,
  "icon_theme": "Material Icon Theme",
  "tabs": { "file_icons": true },
  "preferred_line_length": 100,
  "theme": {
    "mode": "system",
    "light": "Dracula Light (Alucard)",
    "dark": "Dracula Solid"
  },
  "buffer_font_family": "Maple Mono NF CN",
  "buffer_font_size": 14,
  "vim_mode": true,
  "terminal": {
    "font_family": "Maple Mono NF CN",
    "font_size": 14
  },
  "agent": {
    "dock": "left",
    "inline_assistant_model": {
      "provider": "deepseek",
      "model": "deepseek-chat"
    },
    "default_profile": "ask",
    "default_model": {
      "provider": "deepseek",
      "model": "deepseek-reasoner"
    }
  },
  "languages": {
    "Astro": { "formatter": { "language_server": { "name": "biome" } } },
    "CSS": { "formatter": { "language_server": { "name": "biome" } } },
    "HTML": { "formatter": { "language_server": { "name": "biome" } } },
    "JSON": { "formatter": { "language_server": { "name": "biome" } } },
    "JSONC": { "formatter": { "language_server": { "name": "biome" } } },
    "JSX": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "JavaScript": { 
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "Svelte": { "formatter": { "language_server": { "name": "biome" } } },
    "TSX": { 
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "TypeScript": { 
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "Vue.js": { "formatter": { "language_server": { "name": "biome" } } },
    "Python": {
      "formatter": [
        { "language_server": { "name": "ruff" } }
      ],
      "language_servers": ["ty", "!basedpyright", "!pyright", "..."]
    },
    "Ruby": {
      "language_servers": ["ruby-lsp", "rubocop", "tailwindcss-language-server", "!solargraph", "!sorbet", "!steep", "!kanayago", "!fuzzy-ruby-server", "..."]
    },
    "HTML+ERB": {
      "language_servers": ["herb", "ruby-lsp", "!kanayago", "..."]
    },
    "JS+ERB": {
      "language_servers": ["ruby-lsp", "!kanayago", "..."]
    },
    "YAML+ERB": {
      "language_servers": ["ruby-lsp", "!kanayago", "..."]
    }
  },
  "lsp": {
    "biome": {
      "binary": {
        "path": "bunx",
        "arguments": ["biome", "lsp-proxy"]
      },
      "settings": {
        "require_config_file": true
      }
    },
    "rubocop": {
      "initialization_options": {
        "safeAutocorrect": false
      }
    },
    "ruby-lsp": {
      "initialization_options": {
        "enabledFeatures": {
          "diagnostics": false
        }
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "experimental": {
          "classRegex": ["\\bclass:\\s*['\"]([^'\"]*)['\"]"]
        }
      }
    },
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "includeInlayParameterNameHints": "all",
          "includeInlayParameterNameHintsWhenArgumentMatchesName": true,
          "includeInlayFunctionParameterTypeHints": true,
          "includeInlayVariableTypeHints": true,
          "includeInlayVariableTypeHintsWhenTypeMatchesName": true,
          "includeInlayPropertyDeclarationTypeHints": true,
          "includeInlayFunctionLikeReturnTypeHints": true,
          "includeInlayEnumMemberValueHints": true
        }
      }
    }
  }
}
  
